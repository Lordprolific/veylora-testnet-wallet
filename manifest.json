{
  "manifest_version": 3,
  "name": "Veylora Zcash Wallet",
  "short_name": "Veylora",
  "version": "0.3.1",
  "description": "Experimental self-custody Zcash testnet wallet with encrypted local recovery.",
  "minimum_chrome_version": "116",
  "action": {
    "default_title": "Open Veylora Wallet"
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "permissions": [
    "clipboardWrite"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://*/*"
      ],
      "js": [
        "dapp-content.js"
      ],
      "run_at": "document_start"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "dapp-provider.js"
      ],
      "matches": [
        "https://*/*"
      ]
    }
  ],
  "content_security_policy": {
    "extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self'"
  },
  "cross_origin_embedder_policy": {
    "value": "require-corp"
  },
  "cross_origin_opener_policy": {
    "value": "same-origin"
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "host_permissions": [
    "https://zcash-testnet.chainsafe.dev/*"
  ]
}
