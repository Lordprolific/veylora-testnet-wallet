{
  "name": "veylora-zcash-wallet",
  "private": true,
  "version": "0.3.1",
  "type": "module",
  "scripts": {
    "dev": "parcel wallet.html --port 4173",
    "build": "tsc --noEmit && node scripts/generate-icons.mjs && parcel build wallet.html popup.html --dist-dir dist --public-url ./ && node scripts/copy-extension-assets.mjs",
    "test:security": "node --test tests/*.test.mjs",
    "preview": "parcel serve wallet.html --dist-dir dist --port 4174"
  },
  "dependencies": {
    "@scure/bip39": "2.0.1",
    "qrcode": "1.5.4"
  },
  "devDependencies": {
    "@types/qrcode": "1.5.5",
    "parcel": "2.13.3",
    "sharp": "0.34.3",
    "svgo": "3.3.2",
    "typescript": "^5.9.3"
  }
}
